{
  "name": "localarabi-rag-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Feuille de styles du frontend — Tailwind compilé, aucune dépendance externe à l'exécution.",
  "scripts": {
    "build:css": "tailwindcss -i frontend/css/input.css -o frontend/app.css --minify",
