# Environnements virtuels
venv/
.venv/

# Base vectorielle générée
chroma_db/

# Base de données des comptes
*.db
data/app.db

# Cache Python
__pycache__/
*.py[cod]
*.egg-info/

# Configuration d'éditeur : propre à chaque machine, jamais partagée.
.idea/
.vscode/

# Artefacts de test
.pytest_cache/
.coverage
htmlcov/

# Variables d'environnement
.env

# Sauvegardes locales — elles contiennent les VRAIES données (comptes, PDF) :
# les pousser sur GitHub reviendrait à publier votre base en clair.
backups/

# Notes personnelles — ne doivent JAMAIS être poussées sur GitHub
NOTES-PERSO.md

# --- Frontend ---
# Dépendances Node : servent UNIQUEMENT à compiler la feuille de styles.
node_modules/

# Feuille de styles COMPILÉE : c'est un artefact de build, pas une source.
# On versionne frontend/css/input.css et on le compile (npm run build:css),
# exactement comme on ne versionne pas un .pyc.
frontend/app.css

# --- Évaluation ---
# Rapports de mesure : ils contiennent des EXTRAITS du corpus (donc le texte des
# PDF) et sont régénérables par « python scripts/eval_rag.py --run ». Même
# raisonnement que pour frontend/app.css : on versionne la source (le jeu d'or
# eval/golden.jsonl), pas le résultat.
eval/results/

# --- Corpus Shamela ---
# EPUB téléchargés depuis shamela.ws. Le TEXTE est numérique et propre, mais les
# ÉDITIONS modernes sont sous droits d'éditeurs tiers : ne JAMAIS les pousser.
# Cet avertissement est la contrepartie assumée du choix de corpus mixte.
data/shamela/
