# Environnements virtuels locaux
venv/
.venv/

# Données (base vectorielle, PDF, base SQLite) : montées via des volumes,
# jamais copiées dans l'image.
chroma_db/
data/

# Secrets et variables d'environnement
.env
.env.*

# Versioning
.git/
.gitignore

# Cache Python
__pycache__/
*.py[cod]
*.egg-info/

# IDE
.idea/
.vscode/
.junie/

# Fichiers de test locaux
test_main.http

# --- Frontend ---
# Dépendances Node : inutiles dans le contexte, l'étape « styles » les
# réinstalle avec `npm ci` depuis package-lock.json.
node_modules/

# Feuille compilée depuis le poste de développement : l'image la reconstruit
# elle-même, pour ne jamais servir un artefact périmé.
frontend/app.css
