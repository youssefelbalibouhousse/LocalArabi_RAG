# Environnements virtuels
venv/
.venv/

# Base vectorielle générée
chroma_db/

# Base de données des comptes
*.db
data/app.db

# Cache Python
__pycache__/
*.py[cod]
*.egg-info/

# Artefacts de test
.pytest_cache/
.coverage
htmlcov/

# Variables d'environnement
.env

# Sauvegardes locales — elles contiennent les VRAIES données (comptes, PDF) :
# les pousser sur GitHub reviendrait à publier votre base en clair.
backups/

# Notes personnelles — ne doivent JAMAIS être poussées sur GitHub
NOTES-PERSO.md

# --- Frontend ---
# Dépendances Node : servent UNIQUEMENT à compiler la feuille de styles.
node_modules/

# Feuille de styles COMPILÉE : c'est un artefact de build, pas une source.
# On versionne frontend/css/input.css et on le compile (npm run build:css),
# exactement comme on ne versionne pas un .pyc.
frontend/app.css

# IDE
.idea/
.vscode/
