# Copie ce fichier en `.env` et ajuste si besoin.

# URL du serveur Ollama
# Sert à la fois aux EMBEDDINGS (toujours) et à la GÉNÉRATION si LLM_PROVIDER=ollama.
# Peut pointer vers une VM GPU louée (RunPod, EC2, Compute Engine...).
OLLAMA_URL=http://localhost:11434

# --- Fournisseur de génération ---
# "ollama" (défaut) : auto-hébergé, aucune donnée ne sort.
# "openai"          : toute API compatible OpenAI (Groq, Together, vLLM,
#                     OpenRouter, LM Studio, Endpoint managé...).
LLM_PROVIDER=ollama

# Requis uniquement si LLM_PROVIDER=openai :
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=<votre-clé>
#
# Exemples de modèles selon le fournisseur :
#   Ollama   : llama3.1
#   Groq     : llama-3.1-8b-instant
#   Together : meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo
LLM_MODEL=llama3.1

# Modèle d'embedding (toujours servi par Ollama — c'est peu coûteux)
EMBEDDING_MODEL=bge-m3

# Nombre de chunks récupérés par question
N_RESULTS=5

# Ingestion : nombre de chunks écrits par appel à ChromaDB (défaut 32).
# À lire CONJOINTEMENT avec EMBEDDING_TIMEOUT : un lot est embarqué en une
# seule requête. Mesuré ici : ~0,55 s par chunk de ~520 caractères, donc
# 32 chunks ≈ 18 s et 256 chunks ≈ 140 s (au-delà du délai).
# INGEST_BATCH_SIZE=32

# Délai d'expiration d'un appel d'embedding, en secondes (défaut 120).
# Le défaut de la bibliothèque est de 60 s, insuffisant pour un gros lot.
# EMBEDDING_TIMEOUT=120

# Seuil de pertinence : distance maximale acceptée pour un chunk (métrique L2).
# Valeur <= 0 : filtrage désactivé (défaut). Exemple d'activation :
# DISTANCE_THRESHOLD=1.0
#
# ⚠️ Avec la recherche hybride, il ne s'applique qu'aux candidats VECTORIELS,
# avant la fusion : un extrait écarté pour distance peut revenir si la recherche
# lexicale le classe bien.

# --- Recherche hybride (lexicale + vectorielle) ---
# Deux recherches sont menées puis fusionnées par rangs réciproques (RRF).
# Mesuré sur 59 questions validées : 78,0 % -> 98,3 % de hit@10.
# Couper ce drapeau rend exactement l'ancien comportement (utile pour comparer).
HYBRID_ENABLED=true

# Candidats demandés à CHAQUE recherche avant fusion (défaut 50).
# La fusion ne peut pas classer ce qu'on ne lui a pas donné.
# HYBRID_CANDIDATES=50

# Constante d'aplatissement de la fusion, et poids relatifs (défaut 10 / 1 / 1).
#
# ⚠️ Ces valeurs ne sont pas indépendantes de HYBRID_CANDIDATES, et les changer à
# la légère peut SUPPRIMER le bénéfice sans que le score global le montre : avec
# une constante de 60 et un poids de 3 pour le vecteur, le rang 1 lexical était
# battu par le 50e candidat vectoriel, et la recherche lexicale ne pouvait plus
# que reclasser ce que le vecteur avait déjà vu. Voir README.md, « Recherche
# hybride », pour la grille mesurée.
# HYBRID_RRF_K=10
# HYBRID_VECTOR_WEIGHT=1.0
# HYBRID_LEXICAL_WEIGHT=1.0

# --- Citation verbatim (EXPÉRIMENTAL, désactivé par défaut) ---
#
# Exige du modèle une citation RECOPIÉE LITTÉRALEMENT du contexte, entre [[ et ]],
# puis vérifie que cette citation s'y trouve vraiment (app/fidelite.py).
#
# POURQUOI. Trois vérifications déterministes ont échoué : les inventions du
# modèle sont faites du vocabulaire du corpus, donc indistinguables par les mots.
# Ici, le modèle doit ANCRER sa réponse, et une citation fabriquée est
# mécaniquement démontrable.
#
# ⚠️ Mesuré : sur 18 réponses à des questions sans réponse dans le corpus, le
# modèle n'a PAS cité 9 fois, et a produit 1 citation fabriquée — mais il a aussi
# cité 4 fois un passage réel qui ne répondait pas à la question. La citation
# rend une réponse VÉRIFIABLE, elle ne la rend pas JUSTE.
# CITATIONS_OBLIGATOIRES=true

# Origines autorisées par le navigateur (CORS).
# "*" en développement ; en production, mettre l'URL du front séparée par des virgules :
# CORS_ALLOW_ORIGINS=https://mon-site.com,https://www.mon-site.com
CORS_ALLOW_ORIGINS=*

# --- Authentification ---
# Environnement d'exécution : "development" (défaut) ou "production".
# En production, l'application REFUSE de démarrer si SECRET_KEY est absente.
ENVIRONMENT=development

# Niveau de journalisation : DEBUG, INFO, WARNING, ERROR.
# Passer à DEBUG pour diagnostiquer un problème en production.
LOG_LEVEL=INFO

# Nom de domaine public, requis en PRODUCTION uniquement.
# Caddy s'en sert pour obtenir automatiquement un certificat HTTPS Let's Encrypt.
# Prerequis : un enregistrement DNS de type A pointant vers l'IP du serveur.
# DOMAIN=chatbot.mondomaine.com

# Clé secrète de signature des JWT. Doit faire au moins 32 octets (RFC 7518).
# OBLIGATOIRE en production. Générer avec :
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-secret-key-change-me-in-production

# Durée de validité d'un jeton de connexion (en minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Inscription publique : autoriser n'importe qui à créer un compte.
# Valeur par défaut : ouverte en développement, FERMÉE en production.
# Pour un pilote, laisser fermé et créer les comptes avec :
#   python scripts/create_user.py <nom_utilisateur>
# ALLOW_REGISTRATION=false

# --- Limitation de débit (rate limiting) ---
# Format « N/FENÊTRE » : N requêtes maximum par client sur FENÊTRE secondes.
# Les compteurs sont séparés par client (IP) ET par route.
RATE_LIMIT_ENABLED=true

# Connexion : strict, contre les attaques par force brute (5 essais par minute).
LOGIN_RATE_LIMIT=5/60

# Inscription : très strict (5 comptes par heure).
REGISTER_RATE_LIMIT=5/3600

# Question au chatbot : protège votre budget GPU/API (20 par minute).
ASK_RATE_LIMIT=20/60

# --- Sauvegardes (scripts/backup.py) ---
# Nombre d'archives conservées ; au-delà, les plus anciennes sont supprimées.
BACKUP_RETENTION=7

# --- Respect de la langue de la réponse ---
# Le modèle suit imparfaitement la consigne de langue, surtout quand les extraits
# fournis sont en arabe : la langue RÉELLEMENT produite est donc vérifiée, et une
# réécriture est demandée si elle ne correspond pas à celle choisie par l'utilisateur.
LANGUAGE_ENFORCEMENT_ENABLED=true

# Nombre maximum de réécritures par question (0 = aucune).
# Chaque reprise coûte un appel LLM supplémentaire : la plafonner protège le budget.
LANGUAGE_MAX_RETRIES=1

# Base de données des comptes (SQLite par défaut)
# DATABASE_URL=sqlite:///./data/app.db
